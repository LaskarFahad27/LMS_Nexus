# Copy to .env and fill in. On shared hosting, also add these in the Node.js app env UI.

NODE_ENV=production
PORT=5000
HOST=0.0.0.0

# Your live site URL (no trailing slash). Add more origins as comma-separated values.
CLIENT_URL=https://yourdomain.com
PUBLIC_URL=https://yourdomain.com

# PostgreSQL from your hosting panel
DB_HOST=localhost
DB_PORT=5432
DB_USER=your_postgres_user
DB_PASSWORD=your_postgres_password
DB_NAME=your_postgres_db
# Set true if the host requires SSL (common on shared / remote Postgres)
DB_SSL=false
SKIP_DB_CREATE=true
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

UPLOAD_DIR=uploads
PLATFORM_COMMISSION_RATE=0.2

OPENAI_API_KEY=
CRAFTX_API_KEY=

# EPS Payment Gateway — https://pgapi.eps.com.bd
EPS_BASE_URL=https://pgapi.eps.com.bd/v1
EPS_USERNAME=your_eps_merchant_username
EPS_PASSWORD=your_eps_merchant_password
EPS_HASH_KEY=your_eps_hash_key_base64
EPS_MERCHANT_ID=your-merchant-uuid
EPS_STORE_ID=your-store-uuid
EPS_TRANSACTION_TYPE_ID=1
EPS_IPN_SECRET_KEY=your_eps_ipn_secret_key
EPS_CALLBACK_BASE_URL=https://api.YOURDOMAIN.com
FRONTEND_URL=https://YOURDOMAIN.com
EPS_RECONCILE_KEY=replace-with-a-long-random-string
