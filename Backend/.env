# Local development — copy values from your host panel when deploying.
# On cPanel / shared Node.js, you can also paste these into the app's Environment Variables UI.

NODE_ENV=development
PORT=5000
HOST=0.0.0.0

# Frontend origin (comma-separated if you have more than one)
CLIENT_URL=https://nexus-back.corecraftsolutions.com,http://localhost:5173
PUBLIC_URL=https://nexus-back.corecraftsolutions.com

# PostgreSQL — use 127.0.0.1 (not localhost) so it does not try IPv6 ::1
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=corecraf_lmsu2
DB_PASSWORD="01978103277@@"
DB_NAME=corecraf_lmsv2
DB_SSL=false
SKIP_DB_CREATE=true
# Shared hosts sometimes give a single URL instead of the fields above:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# Auth — change JWT_SECRET before going live
JWT_SECRET=lms-nexus-local-dev-secret-change-me
JWT_EXPIRES_IN=7d

UPLOAD_DIR=uploads
PLATFORM_COMMISSION_RATE=0.2

# Optional AI (app still works without these)
OPENAI_API_KEY=
CRAFTX_API_KEY=cc-875f14563dbd43b9abb25a8b68559145

